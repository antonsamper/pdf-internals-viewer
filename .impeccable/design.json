  "narrative": {
    "overview": "The implemented interface follows the user-selected shadcn neutral defaults with Base UI controls. White inspection surfaces, a subtly tinted explorer, thin dividers, and compact typography keep attention on PDF structure and original bytes. Theme and brand exploration are low priority.\n\nThis is a desktop-first developer workspace with dense data and restrained controls. Geist supports navigation and explanations; system monospace distinguishes PDF syntax, object identifiers, offsets, and bytes. Blue references provide the clearest navigational color cue.",
    "keyCharacteristics": [
      "Neutral light surfaces with thin structural borders.",
      "Compact controls and dense, independently scrolling data panes.",
      "System monospace for syntax and original-byte inspection.",
      "Blue object references; dark neutral byte selection."
    ],
    "rules": [
      {
        "name": "The Reference Color Rule",
        "body": "Use reference blue for navigable object relationships; selected original bytes use the primary neutral pair.",
        "section": "colors"
      },
      {
        "name": "The Syntax Type Rule",
        "body": "Keep byte syntax and object identifiers in system monospace while navigation and explanatory copy remain in Geist.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do use the existing semantic neutral tokens and shadcn Base UI controls.",
      "Do use monospace for object syntax, offsets, bytes, and references.",
      "Do preserve the blue reference affordance and visible keyboard focus.",
      "Do keep pane content independently scrollable and use the existing mobile pane switcher.",
      "Do distinguish original file bytes from decoded data and rendered preview."
    ],
    "donts": [
      "Don't introduce a new brand theme or decorative typeface without a user request.",
      "Don't replace the workspace panes with a dashboard of cards.",
      "Don't use reference blue as a general decorative surface or byte selection color.",
      "Don't remove focus indicators or force desktop panes side by side on mobile."
    ]
  }
}
