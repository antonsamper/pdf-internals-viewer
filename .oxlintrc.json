{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "react-perf", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["error", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "@stylistic/padding-line-between-statements": [
      "error",
      { "blankLine": "always", "next": "return", "prev": "*" },
      { "blankLine": "always", "next": "*", "prev": ["const", "let"] },
      { "blankLine": "any", "next": ["const", "let"], "prev": ["const", "let"] },
      { "blankLine": "always", "next": "*", "prev": "block-like" }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "sort-keys": ["error", "asc", { "natural": true }],
    "unicorn/filename-case": ["error", { "case": "kebabCase", "ignore": ["^__root\\.tsx$", "^_app(\\..+)?\\.tsx$"] }],
    "func-style": ["error", "expression"],
    "complexity": ["error", { "max": 10 }],
    "curly": ["error", "all"],
    "arrow-body-style": ["error", "always"],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "cn",
            "message": "Import cn from '@/lib/utils', which knows the theme's type scale."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ],
  "env": {
    "builtin": true,
    "browser": true
  },
  "ignorePatterns": ["dist", "public/**/*.js", "src/routeTree.gen.ts"],
  "jsPlugins": ["@stylistic/eslint-plugin"]
}
