{
  "name": "pdf-internals-viewer",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "prepare:parser": "node scripts/prepare-parser.mjs",
    "postinstall": "pnpm run prepare:deps",
    "predev": "pnpm run prepare:deps",
    "prebuild": "pnpm run prepare:deps",
    "test": "vitest run",
    "pretest": "pnpm run prepare:deps",
    "test:e2e": "playwright test",
    "prepare:deps": "pnpm run prepare:preview && pnpm run prepare:parser",
    "prepare:preview": "node scripts/prepare-preview.mjs",
    "corpus:fetch": "node scripts/corpus/fetch.mjs",
    "test:corpus": "vitest run --config scripts/corpus/vitest.config.ts",
    "pretest:corpus": "pnpm run prepare:deps",
    "check:preview-notices": "node scripts/check-preview-notices.mjs dist",
    "postbuild": "pnpm run check:preview-notices && pnpm run check:native-notices --dist",
    "deploy:check": "pnpm run build && pnpm run check:pages-assets",
    "deploy": "pnpm run deploy:check && wrangler pages deploy dist --project-name pdf-internals-viewer --branch main",
    "preview:cloudflare": "wrangler pages dev dist --ip 127.0.0.1 --port 8787",
    "check:native-notices": "node scripts/check-native-notices.mjs",
    "predeploy": "pnpm run check:native-notices",
    "check:pages-assets": "node scripts/check-pages-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@embedpdf/engine": "3.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@libpdf/core": "0.5.3",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.21.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5.1.0",
    "wrangler": "4.160.1"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.4"
}
