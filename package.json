{
  "name": "pdf-internals-viewer",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./inspection": "./src/generated/libpdf-inspection.mjs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-prerender.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write \"**/*.{ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "prepare:parser": "node scripts/prepare-parser.mjs",
    "postinstall": "pnpm run prepare:deps",
    "predev": "pnpm run prepare:deps",
    "prebuild": "pnpm run prepare:deps",
    "test": "vitest run",
    "pretest": "pnpm run prepare:deps",
    "test:e2e": "playwright test",
    "prepare:deps": "pnpm run prepare:parser",
    "corpus:fetch": "node scripts/corpus/fetch-corpus.mjs",
    "test:corpus": "vitest run --config scripts/corpus/vitest.config.ts",
    "pretest:corpus": "pnpm run prepare:deps",
    "postbuild": "pnpm run check:native-notices --dist && pnpm run check:public-pages",
    "deploy:check": "pnpm run build && pnpm run check:pages-assets",
    "preview:cloudflare": "wrangler pages dev dist --ip 127.0.0.1 --port 8787",
    "check:native-notices": "node scripts/check-native-notices.mjs",
    "check:pages-assets": "node scripts/check-pages-assets.mjs",
    "check:public-pages": "node scripts/check-public-pages.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@embedpdf/engine": "3.4.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@libpdf/core": "0.5.3",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "react-doctor": "^0.9.23",
    "typescript": "~7.0.2",
    "vite": "^8",
    "vitest": "^5.1.1",
    "wrangler": "4.160.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,css,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.33.4"
}
